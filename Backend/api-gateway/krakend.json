{
  "$schema": "https://www.krakend.io/schema/v3.0/krakend.json",
  "version": 3,
  "port": 8086,
  "timeout": "30s",
  "endpoints": [
    {
      "endpoint": "/v1/public/{path}",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/v1/public/{path}",
          "host": ["http://bff:8084"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/bff/web/auth/register",
      "method": "POST",
      "input_headers": ["*"],
      "backend": [
        {
          "url_pattern": "/api/v1/bff/web/auth/register",
          "host": ["http://bff:8084"],
          "encoding": "no-op"
        }
      ],
      "output_encoding": "no-op"
    },
    {
      "endpoint": "/api/v1/bff/web/auth/login",
      "method": "POST",
      "input_headers": ["*"],
      "backend": [
        {
          "url_pattern": "/api/v1/bff/web/auth/login",
          "host": ["http://bff:8084"],
          "encoding": "no-op"
        }
      ],
      "output_encoding": "no-op"
    },
    {
      "endpoint": "/api/v1/bff/web/users/profile",
      "method": "GET",
      "input_headers": ["*"],
      "input_query_strings": ["*"],
      "backend": [
        {
          "url_pattern": "/api/v1/bff/web/users/profile",
          "host": ["http://bff:8084"],
          "encoding": "no-op"
        }
      ],
      "output_encoding": "no-op"
    },{
      "endpoint": "/api/v1/bff/web/pets/pet-types",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/api/v1/bff/web/pets/pet-types",
          "host": [
            "http://bff:8084"
          ],
          "is_collection": true
        }
      ]
    },
    {
      "endpoint": "/api/v1/bff/web/pets",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/api/v1/bff/web/pets",
          "host": [
            "http://bff:8084"
          ],
          "is_collection": true
        }
      ]
    },
    {
      "endpoint": "/api/v1/bff/web/pets",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/api/v1/bff/web/pets",
          "host": [
            "http://bff:8084"
          ]
        }
      ]
    }
  ]
}
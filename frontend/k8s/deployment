# Deployment del frontend React servido por nginx.
# nginx solo sirve archivos estaticos generados por el build de Vite.
# No hace proxy de /api: Traefik enruta /api directamente a KrakenD.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  namespace: microservicios
  labels:
    app: frontend
spec:
  replicas: 2
  selector:
    matchLabels:
      app: frontend
  template:
    metadata:
      labels:
        app: frontend
    spec:
      containers:
        - name: frontend
          # Imagen construida localmente con el Dockerfile multi-stage.
          image: frontend:1.0
          imagePullPolicy: IfNotPresent
          ports:
            # nginx escucha en el puerto 80 dentro del contenedor.
            - containerPort: 80
          env:
            - name: NODE_ENV
              value: "production"
          readinessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 5
            periodSeconds: 10
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 30
            periodSeconds: 20
          resources:
            requests:
              memory: "64Mi"
              cpu: "100m"
            limits:
              memory: "256Mi"
              cpu: "500m"
---
# Service para exponer el pod de frontend dentro del cluster.
# Traefik lo alcanzara a traves de este Service.
apiVersion: v1
kind: Service
metadata:
  name: frontend
  namespace: microservicios
  labels:
    app: frontend
spec:
  selector:
    app: frontend
  ports:
    - protocol: TCP
      # Puerto del Service dentro del cluster.
      port: 80
      # Puerto del contenedor (nginx).
      targetPort: 80
  type: ClusterIP